
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in, sel=sel[2], a=upper, b=lower);

    DMux(in=upper, sel=sel[1], a=u0, b=u1);
    DMux(in=lower, sel=sel[1], a=l0, b=l1);

    DMux(in=u0, sel=sel[0], a=a, b=b);
    DMux(in=u1, sel=sel[0], a=c, b=d);
    DMux(in=l0, sel=sel[0], a=e, b=f);
    DMux(in=l1, sel=sel[0], a=g, b=h);
}
