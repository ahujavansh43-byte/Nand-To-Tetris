
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Select RAM or upper memory region
    DMux(in=load, sel=address[14],
         a=loadRAM, b=loadUpper);

    // RAM: 0 to 16383
    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Select Screen or Keyboard region
    DMux(in=loadUpper, sel=address[13],
         a=loadScreen, b=unusedLoad);

    // Screen: 16384 to 24575
    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard: read-only
    Keyboard(out=keyboardOut);

    // Select RAM or Screen
    Mux16(
        a=ramOut,
        b=screenOut,
        sel=address[14],
        out=ramScreenOut
    );

    // Select Keyboard at address 24576
    And(a=address[14], b=address[13], out=selectKeyboard);

    Mux16(
        a=ramScreenOut,
        b=keyboardOut,
        sel=selectKeyboard,
        out=out
    );
}
